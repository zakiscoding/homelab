# Managed by Ansible (infra/ansible/roles/k3s). Read by the k3s server at startup.
write-kubeconfig-mode: "{{ k3s_write_kubeconfig_mode }}"
{% if k3s_tls_san | length > 0 %}
tls-san:
{% for san in k3s_tls_san %}
  - "{{ san }}"
{% endfor %}
{% endif %}
{% if k3s_nvidia_default_runtime | bool %}
default-runtime: nvidia
{% endif %}
