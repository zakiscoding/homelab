# Managed by Ansible (infra/ansible/roles/node_exporter).
[Unit]
Description=Prometheus node_exporter {{ node_exporter_version }}
Wants=network-online.target
After=network-online.target

[Service]
User=node_exporter
Group=node_exporter
ExecStart={{ node_exporter_install_dir }}/node_exporter --web.listen-address={{ node_exporter_listen_address }}
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
